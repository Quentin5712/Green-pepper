# ══════════════════════════════════════════════
# Green Pepper Market — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# NE COMMITEZ JAMAIS .env sur GitHub
# ══════════════════════════════════════════════

# Serveur
PORT=3000
NODE_ENV=production

# MongoDB Atlas
# Obtenir sur : cloud.mongodb.com → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/greenpepperDB?retryWrites=true&w=majority

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_jwt_secret_long_et_aleatoire_ici_minimum_32_chars
JWT_REFRESH_SECRET=votre_refresh_secret_different_du_jwt_secret_ici

# Admin (quentin et oceane)
# Login = username, password = en clair ici, stocké en bcrypt dans ADMIN_PASS_HASH
ADMIN_USER=quentin
# Générer : node -e "require('bcryptjs').hash('VotreMotDePasse',12).then(console.log)"
ADMIN_PASS_HASH=$2a$12$xxxx_hash_bcrypt_du_mot_de_passe_admin

# KPay Production
KPAY_API_KEY=kpay_live_votre_cle_api_ici
KPAY_BASE_URL=https://admin.kpay.site
KPAY_GATEWAY_SECRET=votre_secret_hmac_pour_verifier_les_callbacks

# Orange Money (optionnel)
OM_CLIENT_ID=votre_client_id_orange
OM_CLIENT_SECRET=votre_client_secret_orange
OM_MERCHANT_KEY=votre_merchant_key_orange

# CORS — domaine(s) autorisés séparés par virgule
ALLOWED_ORIGINS=https://green-pepper.onrender.com,https://votre-domaine.com
