# ════════════════════════════════════════════════════════════
# .env.example — Green Pepper Market
# COPIEZ ce fichier en .env et remplissez les vraies valeurs
# Ne commitez JAMAIS le fichier .env sur GitHub
# ════════════════════════════════════════════════════════════

# ── MongoDB Atlas ──────────────────────────────────────────
# Où trouver ce lien :
#   Atlas → Database → Connect → Drivers → Node.js → copiez l'URI
#   Remplacez <password> par votre mot de passe Atlas
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/greenpepperDB?retryWrites=true&w=majority

# ── Serveur ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT (générez une clé longue et aléatoire) ──────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_cle_secrete_tres_longue_ici

# ── MTN MoMo Production ────────────────────────────────────
# Obtenir sur : developer.mtn.com → Products → MoMo API → Cameroon Collection
MOMO_ENV=mtncameroon
MOMO_SUBSCRIPTION_KEY=votre_cle_abonnement_mtn
MOMO_API_USER=votre_uuid_api_user
MOMO_API_KEY=votre_api_key_mtn
CALLBACK_URL=https://votre-app.onrender.com

# ── Orange Money (optionnel) ───────────────────────────────
# Obtenir sur : developer.orange.com
OM_CLIENT_ID=votre_client_id_orange
OM_CLIENT_SECRET=votre_client_secret_orange
OM_MERCHANT_KEY=votre_merchant_key

# ── CORS ───────────────────────────────────────────────────
# Votre domaine Render (pour bloquer les requêtes d'autres origines)
ALLOWED_ORIGINS=https://votre-app.onrender.com

# ── JSONBin (ancienne DB — seulement pour la migration) ────
# Supprimez ces lignes après la migration vers MongoDB
BIN_ID=votre_bin_id
API_KEY=votre_cle_jsonbin
