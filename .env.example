# ══════════════════════════════════════
# Green Pepper Market — Variables d'env
# Copiez en .env et remplissez les valeurs
# Ne commitez JAMAIS .env sur GitHub
# ══════════════════════════════════════

# Serveur
PORT=3000
NODE_ENV=production

# MongoDB Atlas
# Atlas → Database → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/greenpepperDB?retryWrites=true&w=majority

# JWT
JWT_SECRET=votre_cle_secrete_longue_et_aleatoire_ici

# MTN MoMo Collection API (developer.mtn.com)
MOMO_ENV=mtncameroon
MOMO_SUBSCRIPTION_KEY=votre_cle_abonnement_mtn
MOMO_API_USER=votre_uuid_api_user
MOMO_API_KEY=votre_api_key_mtn
MOMO_CALLBACK_URL=https://votre-app.onrender.com/api/payment/callback

# Orange Money (developer.orange.com)
OM_CLIENT_ID=votre_client_id_orange
OM_CLIENT_SECRET=votre_client_secret_orange
OM_MERCHANT_KEY=votre_merchant_key_orange

# Sécurité paiement HMAC
GATEWAY_SECRET=votre_secret_hmac_gateway

# CORS
ALLOWED_ORIGINS=https://votre-app.onrender.com

# Admin
ADMIN_EMAIL=admin@greenpeppermarket.cm
ADMIN_PASSWORD=VotreMotDePasseAdmin123
